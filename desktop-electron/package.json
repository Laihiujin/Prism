{
  "name": "Prism",
  "version": "1.1.0",
  "description": "Prism",
  "main": "src/main/index.js",
  "author": "Laihiujin",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env PRISM_START_SERVICES=1 PRISM_START_FRONTEND=1 electron .",
    "dev:watch": "node scripts/dev-watch.js",
    "build": "node scripts/build-native.cjs",
    "build:dir": "node scripts/build-native.cjs --dir",
    "pack": "node scripts/build-native.cjs --dir",
    "postinstall": "electron-builder install-app-deps",
    "release:win": "node scripts/build-native.cjs --platform=win32",
    "release:finalize": "node scripts/finalize-windows-release.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "release:version-index": "node scripts/build-version-index.mjs",
    "release:mac": "node scripts/build-native.cjs --platform=darwin"
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.prism.automation",
    "productName": "Prism",
    "artifactName": "Prism-${version}-setup.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "asarUnpack": [
      "src/renderer/**",
      "src/preload/**"
    ],
    "directories": {
      "output": "dist-build",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "icon.ico",
      "icon.png",
      "tray.png"
    ],
    "extraResources": [
      {
        "from": "../tools/hermes-agent",
        "to": "tools/hermes-agent",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.pytest_cache/**",
          "!**/tests/**",
          "!**/node_modules/**",
          "!**/.venv/**",
          "!**/.hermes/**",
          "!**/*.egg-info/**",
          "!**/nul",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*"
        ]
      },
      {
        "from": "../tools/hermes-webui",
        "to": "tools/hermes-webui",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.github/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/tests/**",
          "!**/docs/**",
          "!**/nul",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*"
        ]
      },
      {
        "from": "../tools/persona-studio",
        "to": "tools/persona-studio",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.github/**",
          "!**/docs/**",
          "!**/dashboard/logs/**",
          "!**/data/**",
          "!**/tests/**",
          "!**/nul",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*"
        ]
      },
      {
        "from": "../scripts/hermes",
        "to": "scripts/hermes",
        "filter": [
          "*.ps1",
          "*.cmd"
        ]
      },
      {
        "from": "../scripts/packaging",
        "to": "scripts/packaging",
        "filter": [
          "install_hibbiki_chromium.ps1"
        ]
      },
      {
        "from": "../prism_backend",
        "to": "prism_backend",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/test_*",
          "!**/tests",
          "!**/.pytest_cache",
          "!**/data/cookies/**",
          "!**/cookiesFile/**",
          "!**/fingerprints/**",
          "!**/browser_profiles/**",
          "!**/videoFile/**",
          "!**/logs/**",
          "!**/db/*.db",
          "!**/db/*.db-*",
          "!**/db/*.sqlite",
          "!**/db/*.sqlite-*",
          "!**/db/frontend_accounts_snapshot.json",
          "!**/config/llm_config.toml",
          "!**/config/hermes_agent.toml",
          "!**/crawlers/**/config.yaml",
          "!**/backups/**",
          "!**/nul",
          "!**/.env*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/*.sqlite*",
          "!**/data/**",
          "!**/storage/**",
          "!**/reverse_api/artifacts/**"
        ]
      },
      {
        "from": "../prism_frontend/.next/standalone",
        "to": "frontend/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../prism_frontend/.next/static",
        "to": "frontend/standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../prism_frontend/public",
        "to": "frontend/standalone/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "conf.py",
          "conf.example.py"
        ]
      },
      {
        "from": "../scripts/runtime",
        "to": "scripts/runtime",
        "filter": [
          "*.cjs",
          "*.json",
          "*.html",
          "!*.test.cjs"
        ]
      },
      {
        "from": "../scripts/packaging/provision",
        "to": "scripts/packaging/provision",
        "filter": [
          "*.py",
          "*.json",
          "*.txt",
          "components/**"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../scripts/ensure-node.ps1",
        "to": "scripts/ensure-node.ps1"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "Laihiujin",
      "legalTrademarks": "Laihiujin",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "resources/pm2",
          "to": "pm2",
          "filter": [
            "pm2_controller.js",
            "ecosystem.desktop.config.js"
          ]
        },
        {
          "from": "resources/node_modules",
          "to": "node_modules",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "node_modules/7zip-bin/win/x64",
          "to": "tools/7zip",
          "filter": [
            "7za.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prism",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true
    },
    "compression": "maximum",
    "electronVersion": "39.2.7",
    "publish": [
      {
        "provider": "github",
        "owner": "Laihiujin",
        "repo": "Prism",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "Prism-${version}-${arch}-setup.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "resources/pm2",
          "to": "pm2",
          "filter": [
            "pm2_controller.js",
            "ecosystem.desktop.config.js"
          ]
        },
        {
          "from": "resources/node_modules",
          "to": "node_modules",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "repository": "https://github.com/Laihiujin/Prism.git"
}
