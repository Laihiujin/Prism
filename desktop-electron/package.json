{
  "name": "Prism",
  "version": "1.1.0",
  "description": "Prism",
  "main": "src/main/index.js",
  "author": "Laihiujin",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env PRISM_START_SERVICES=1 PRISM_START_FRONTEND=1 electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "release:win": "npm run build",
    "release:finalize": "node scripts/finalize-windows-release.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "release:version-index": "node scripts/build-version-index.mjs"
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.prism.automation",
    "productName": "Prism",
    "artifactName": "Prism-${version}-setup.${ext}",
    "asar": true,
    "asarUnpack": [
      "src/renderer/**",
      "src/preload/**"
    ],
    "directories": {
      "output": "dist-build",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../prismenv",
        "to": "prismenv",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/nul"
        ]
      },
      {
        "from": "../tools/hermes-agent",
        "to": "tools/hermes-agent",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.pytest_cache/**",
          "!**/tests/**",
          "!**/node_modules/**",
          "!**/web/**",
          "!**/.venv/**",
          "!**/*.egg-info/**",
          "!**/nul"
        ]
      },
      {
        "from": "../tools/hermes-webui",
        "to": "tools/hermes-webui",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.github/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/tests/**",
          "!**/docs/**",
          "!**/nul"
        ]
      },
      {
        "from": "../scripts/hermes",
        "to": "scripts/hermes",
        "filter": [
          "*.ps1",
          "*.cmd"
        ]
      },
      {
        "from": "../scripts/packaging",
        "to": "scripts/packaging",
        "filter": [
          "install_hibbiki_chromium.ps1"
        ]
      },
      {
        "from": "../prism_backend",
        "to": "prism_backend",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/test_*",
          "!**/tests",
          "!**/.pytest_cache",
          "!**/data/cookies/**",
          "!**/cookiesFile/**",
          "!**/fingerprints/**",
          "!**/browser_profiles/**",
          "!**/videoFile/**",
          "!**/logs/**",
          "!**/db/*.db",
          "!**/db/*.db-*",
          "!**/db/*.sqlite",
          "!**/db/*.sqlite-*",
          "!**/db/frontend_accounts_snapshot.json",
          "!**/backups/**",
          "!**/nul"
        ]
      },
      {
        "from": "../prism_frontend/.next/standalone",
        "to": "frontend/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../prism_frontend/.next/static",
        "to": "frontend/standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../prism_frontend/public",
        "to": "frontend/standalone/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "Laihiujin",
      "legalTrademarks": "Laihiujin",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "resources/supervisor",
          "to": "supervisor",
          "filter": [
            "supervisor.exe"
          ]
        },
        {
          "from": "resources/redis",
          "to": "redis",
          "filter": [
            "redis-server.exe",
            "redis-cli.exe",
            "redis.windows.conf",
            "redis.windows-service.conf",
            "EventLog.dll"
          ]
        },
        {
          "from": "../dist/services",
          "to": "services",
          "filter": [
            "**/*",
            "!**/nul"
          ]
        },
        {
          "from": "node_modules/7zip-bin/win/x64",
          "to": "tools/7zip",
          "filter": [
            "7za.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prism",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true
    },
    "compression": "maximum",
    "electronVersion": "28.0.0",
    "publish": [
      {
        "provider": "github",
        "owner": "Laihiujin",
        "repo": "Prism",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "resources/supervisor",
          "to": "supervisor",
          "filter": [
            "supervisor.py",
            "api_server.py"
          ]
        }
      ]
    }
  },
  "repository": "https://github.com/Laihiujin/Prism.git"
}
